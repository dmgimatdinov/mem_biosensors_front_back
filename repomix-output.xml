[pytest]
pythonpath = .
testpaths = tests
addopts = -v --strict-markers --tb=short -n auto --dist=loadfile
# -n auto = auto-determine number of cores for parallel execution
# --dist=loadfile groups tests by file for better xdist stability
timeout = 30
timeout_method = thread

markers =
    smoke: smoke tests (startup, migrations, env) — must pass FIRST
    unit: unit tests (fast, <1s each)
    integration: integration tests (medium, <5s each)
    contract: contract tests (API schemas)
    security: security tests
    performance: performance tests (may be slow)
    e2e: end-to-end tests (slow)
    slow: tests that take more than 5 seconds
    fast: tests that take less than 1s

python_files = test_*.py
python_classes = Test*
python_functions = test_*

# Suppress known warnings
filterwarnings =
    ignore::DeprecationWarning
    ignore::pytest.PytestUnraisableExceptionWarning
</file>

