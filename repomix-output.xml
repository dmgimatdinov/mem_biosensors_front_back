	@if [ "$(OS)" = "Windows_NT" ]; then \
		cd e2e && npx playwright install chromium; \
	elif [ "$(shell uname -s)" = "Darwin" ]; then \
		cd e2e && npx playwright install chromium; \
	else \
		cd e2e && npx playwright install --with-deps chromium; \
	fi
