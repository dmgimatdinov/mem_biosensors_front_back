              {/* MOBILE table */}
              <div className="md:hidden">
                <div className="max-h-[24rem] overflow-y-auto rounded-lg border border-border">
                  <Table>
                    <TableHeader className="sticky top-0 z-10 bg-muted/95 backdrop-blur-sm">
