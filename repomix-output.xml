		if (/^[a-zA-Z0-9_.-]+:.*?##.*$$/) {printf "  ${YELLOW}%-20s${RESET} ${GREEN}%s${RESET}\n", $$1, $$2} \
		else if (/^## .*$$/) {printf "  ${GREEN}%s${RESET}\n", substr($$1,4)} \
	}' $(MAKEFILE_LIST)

## Installation
install: ## Установить зависимости backend
