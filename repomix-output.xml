        db_path = tmp_path / "minimal.db"
        monkeypatch.setenv("DATABASE_URL", f"sqlite:///{db_path}")
        
        import backend.main
        importlib.reload(backend.main)
        
        # Приложение должно запуститься
        assert backend.main.app is not None
